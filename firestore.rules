rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Rule for global templates
    match /templates/{document=**} {
      // Anyone can read (guests or signed-in users) so templates are instantly usable
      allow read: if true;

      // Only the verified admin can modify templates
      allow write: if request.auth != null && 
                     (request.auth.token.email.matches('(?i)^sovannetmeas\\.sm@gmail\\.com$') ||
                      request.auth.token.email == 'sovannetmeas.sm@gmail.com' ||
                      request.auth.token.email == 'SovannetMeas.SM@gmail.com');
    }

    // 2. Global catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
